# Use Alpine for minimal image size (~50MB vs ~900MB for full Node image)
FROM node:20-alpine

# Run as non-root user — container security best practice
WORKDIR /app

# Copy package files first — Docker layer caching:
# If code changes but package.json doesn't, npm ci is skipped on rebuild
COPY package*.json ./
RUN npm ci --only=production

COPY . .

EXPOSE 3000

# Drop root privileges inside the container
USER node

CMD ["node", "server.js"]